# AgukaMed Environment Configuration
# Copy to .env and fill in. Leave blank to run in Demo Mode.

PORT=3000

# MongoDB connection string (required for persistence)
# Get from: https://cloud.mongodb.com (Database Access > Connect > Drivers)
MONGODB_URI=

# Google Gemini Vision + AI Simplifier (optional)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ElevenLabs TTS (optional, falls back to Google TTS if not set)
# Get key at: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# WhatsApp Cloud API (optional)
# Get from: https://developers.facebook.com/apps
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=agukamed_token
